#!/usr/bin/env bash
# pre-commit: only when staged files touch core (.githooks/core_paths)
#   1. weekly-check gate: .git/last_weekly_check must be at most 7 days old
#   2. invariant tests:   pytest tests/invariants -q must pass
#
# The tests run in the gqe_qsci_cpu Docker container, the same environment as
# local runs: it has pytest, pyscf, pyci and cudaq, which no Windows Python
# here does. Docker Desktop must be running. INVARIANTS_CMD overrides the test
# command (e.g. on a machine without Docker).
set -uo pipefail
. "$(git rev-parse --show-toplevel)/.githooks/lib.sh"

core="$(staged_core_files)"
[ -z "$core" ] && exit 0

echo "pre-commit: staged core files:"
printf '%s\n' "$core" | sed 's/^/  /'

# --- 1. weekly check -------------------------------------------------------
stamp="$(git rev-parse --git-dir)/last_weekly_check"
overdue() {
    echo
    echo "Weekly check overdue. Say 'weekly check' in Cowork first."
    exit 1
}
[ -f "$stamp" ] || overdue
last="$(tr -d '\r[:space:]' < "$stamp")"
last_s="$(date -d "$last" +%s 2>/dev/null)" || overdue
today_s="$(date -d "$(date +%F)" +%s)"
(( (today_s - last_s) / 86400 > 7 )) && overdue

# --- 2. invariant tests ----------------------------------------------------
cd "$REPO_ROOT" || exit 1
if [ -n "${INVARIANTS_CMD:-}" ]; then
    echo "pre-commit: $INVARIANTS_CMD"
    eval "$INVARIANTS_CMD"
    rc=$?
else
    if ! docker info >/dev/null 2>&1; then
        echo
        echo "pre-commit: Docker is not running (the invariant tests run in the"
        echo "gqe_qsci_cpu container). Start Docker Desktop and commit again."
        echo "Commit aborted."
        exit 1
    fi
    echo "pre-commit: pytest tests/invariants -q  (in gqe_qsci_cpu)"
    # MSYS_NO_PATHCONV: Git for Windows' bash would otherwise rewrite
    # /workspace into a Windows path. `bash -c`, not a login shell, skips the
    # CUDA-Q banner; the imports do not need it. -p no:cacheprovider keeps
    # pytest from writing .pytest_cache into the repo.
    MSYS_NO_PATHCONV=1 docker run --rm --entrypoint /bin/bash \
        -v "$REPO_ROOT:/workspace" -w /workspace \
        -e PYTHONPATH=/workspace -e PYTHONDONTWRITEBYTECODE=1 \
        -e OMPI_MCA_pml=ob1 -e OMPI_MCA_btl=self,tcp \
        -e OMPI_MCA_opal_warn_on_missing_libcuda=0 \
        gqe_qsci_cpu -c "python3 -m pytest tests/invariants -q -p no:cacheprovider"
    rc=$?
fi
case $rc in
    0) ;;
    5) echo "pre-commit: no invariant tests collected yet; not blocking." ;;
    *) echo
       echo "pre-commit: invariant tests failed (exit $rc). Commit aborted."
       exit 1 ;;
esac
exit 0
