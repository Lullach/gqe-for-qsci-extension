# the GRPO ratio uses)
gqe_qsci/gqe/loss.py
gqe_qsci/gqe/buffer.py
gqe_qsci/train_pipeline.py

# physics analyses whose numbers go into the thesis
hpc/subspace_requirement.py
hpc/entropy_scan.py
hpc/energy_vs_overlap.py

