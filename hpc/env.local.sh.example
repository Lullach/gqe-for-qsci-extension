# ABCI-Q account settings — PERSONAL, do not commit.
#
# Copy this file to env.local.sh (already gitignored) and fill in your own
# values. Then, on the login node:
#
#   source hpc/env.local.sh
#
# before running build_image.sh or submitting jobs.

export ABCIQ_USER="your_username"     # e.g. qci#####xx
export ABCIQ_GROUP="your_group"       # e.g. qg#######  (used as -W group_list=)
